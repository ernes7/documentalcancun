---
import { meta, footer } from '../../data/content';
import Text from '../ui/Text.astro';
---

<footer class="py-12 md:py-16 bg-surface">
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center gap-6">
      <!-- Documentary metadata -->
      <div class="flex flex-wrap justify-center gap-4 md:gap-6">
        <div class="flex items-center gap-2">
          <span class="text-white text-xs uppercase tracking-wider">Duración</span>
          <span class="text-white text-small font-medium">{meta.duration}</span>
        </div>
        <div class="h-4 w-px bg-white hidden md:block"></div>
        <div class="flex items-center gap-2">
          <span class="text-white text-xs uppercase tracking-wider">País</span>
          <span class="text-white text-small font-medium">{meta.country}</span>
        </div>
        <div class="h-4 w-px bg-white hidden md:block"></div>
        <div class="flex items-center gap-2">
          <span class="text-white text-xs uppercase tracking-wider">Categoría</span>
          <span class="text-white text-small font-medium">{meta.category}</span>
        </div>
        <div class="h-4 w-px bg-white hidden md:block"></div>
        <div class="flex items-center gap-2">
          <span class="text-white text-xs uppercase tracking-wider">Género</span>
          <span class="text-white text-small font-medium">{meta.genre}</span>
        </div>
        <div class="h-4 w-px bg-white hidden md:block"></div>
        <div class="flex items-center gap-2">
          <span class="text-white text-xs uppercase tracking-wider">Tema</span>
          <span class="text-white text-small font-medium">{meta.theme}</span>
        </div>
      </div>

      <!-- Síguenos + Instagram -->
      <div class="flex flex-col items-center gap-3">
        <span class="text-white text-sm uppercase tracking-wider">Síguenos</span>
        <a
          href={footer.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-white text-white hover:bg-white hover:text-background transition-all duration-300"
          aria-label="Instagram Los Olvidos del Paraíso"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
      </div>

      <!-- Divider -->
      <div class="w-16 h-px bg-gradient-to-r from-transparent via-primary to-transparent"></div>

      <!-- Copyright -->
      <Text variant="muted" class="text-small">
        {footer.copyright}
      </Text>

      <!-- Virtessa credit -->
      <a
        href="https://virtessa.com"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 opacity-50 hover:opacity-80 transition-opacity duration-300"
      >
        <span class="text-white text-xs uppercase tracking-wider">Made by</span>
        <img
          src="/images/virtessa-logo.png"
          alt="Virtessa"
          class="h-5 w-auto"
        />
      </a>
    </div>
  </div>
</footer>
