---
import { getImage } from 'astro:assets';
import { trailer } from '../../data/content';
import Section from '../layout/Section.astro';
import Heading from '../ui/Heading.astro';
import FadeIn from '../animation/FadeIn.astro';
import ScrollReveal from '../animation/ScrollReveal.astro';
import heroBanner from '../../assets/hero/hero-banner.jpg';

const optimizedThumbnail = await getImage({
  src: heroBanner,
  width: 1280,
  height: 720,
  format: 'webp',
  quality: 95
});

const youtubeVideoId = '5g4PwJZ13eU';
---

<Section id="trailer" variant="default" padding="xl">
  <div class="max-w-5xl mx-auto">
    <FadeIn>
      <Heading level={2} size="h2" class="text-center mb-12 text-white">
        {trailer.title}
      </Heading>
    </FadeIn>

    <ScrollReveal animation="scale">
      <div
        class="trailer-player relative aspect-video bg-surface rounded-xl overflow-hidden cursor-pointer group shadow-2xl"
        role="button"
        tabindex="0"
        aria-label={`Reproducir: ${trailer.thumbnailAlt}`}
        data-video-id={youtubeVideoId}
      >
        <!-- Thumbnail -->
        <img
          src={optimizedThumbnail.src}
          alt={trailer.thumbnailAlt}
          loading="lazy"
          class="trailer-poster absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <!-- Overlay gradient -->
        <div class="trailer-overlay absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-300"></div>

        <!-- Play button -->
        <div class="trailer-play absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-primary/90 flex items-center justify-center shadow-glow transition-all duration-300 group-hover:scale-110 group-hover:bg-primary">
            <svg
              class="w-8 h-8 md:w-10 md:h-10 text-white ml-1"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>

        <!-- YouTube iframe container (hidden until play) -->
        <div class="trailer-iframe-container absolute inset-0 hidden">
          <div id="trailer-yt-player" class="w-full h-full"></div>
        </div>
      </div>
    </ScrollReveal>
  </div>
</Section>

<script>
  function initTrailerPlayer() {
    const players = document.querySelectorAll('.trailer-player:not([data-initialized])');

    players.forEach((player) => {
      player.setAttribute('data-initialized', 'true');

      const poster = player.querySelector('.trailer-poster') as HTMLElement;
      const overlay = player.querySelector('.trailer-overlay') as HTMLElement;
      const playBtn = player.querySelector('.trailer-play') as HTMLElement;
      const iframeContainer = player.querySelector('.trailer-iframe-container') as HTMLElement;
      const videoId = player.getAttribute('data-video-id');

      if (!videoId) return;

      let ytPlayer: YT.Player | null = null;
      let isPlaying = false;

      function showPlayer() {
        poster.classList.add('hidden');
        overlay.classList.add('hidden');
        playBtn.classList.add('hidden');
        iframeContainer.classList.remove('hidden');
        player.classList.remove('cursor-pointer');
        player.removeAttribute('role');
        player.removeAttribute('tabindex');
        isPlaying = true;
      }

      function resetToInitial() {
        iframeContainer.classList.add('hidden');
        poster.classList.remove('hidden');
        overlay.classList.remove('hidden');
        playBtn.classList.remove('hidden');
        player.classList.add('cursor-pointer');
        player.setAttribute('role', 'button');
        player.setAttribute('tabindex', '0');
        isPlaying = false;

        // Destroy the player so a fresh one is created on next click
        if (ytPlayer) {
          ytPlayer.destroy();
          ytPlayer = null;
        }
      }

      function loadYTApi(): Promise<void> {
        return new Promise((resolve) => {
          if (window.YT && window.YT.Player) {
            resolve();
            return;
          }
          // If script is already loading, wait for callback
          if (document.querySelector('script[src*="youtube.com/iframe_api"]')) {
            const check = setInterval(() => {
              if (window.YT && window.YT.Player) {
                clearInterval(check);
                resolve();
              }
            }, 100);
            return;
          }
          const tag = document.createElement('script');
          tag.src = 'https://www.youtube.com/iframe_api';
          document.head.appendChild(tag);
          (window as any).onYouTubeIframeAPIReady = () => resolve();
        });
      }

      async function handlePlay() {
        if (isPlaying) return;
        showPlayer();

        await loadYTApi();

        const targetEl = iframeContainer.querySelector('#trailer-yt-player') || iframeContainer;

        // Create a fresh div for the player
        const playerDiv = document.createElement('div');
        playerDiv.className = 'w-full h-full';
        iframeContainer.innerHTML = '';
        iframeContainer.appendChild(playerDiv);

        ytPlayer = new YT.Player(playerDiv, {
          videoId: videoId!,
          playerVars: {
            autoplay: 1,
            rel: 0,
            modestbranding: 1,
          },
          events: {
            onStateChange: (event: YT.OnStateChangeEvent) => {
              // YT.PlayerState.ENDED === 0
              if (event.data === 0) {
                resetToInitial();
              }
            },
          },
        });
      }

      player.addEventListener('click', (e) => {
        if ((e.target as Element).closest('.trailer-iframe-container')) return;
        handlePlay();
      });

      player.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          handlePlay();
        }
      });
    });
  }

  initTrailerPlayer();
  document.addEventListener('astro:page-load', initTrailerPlayer);
</script>
