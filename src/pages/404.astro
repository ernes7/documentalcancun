---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página Olvidada | Los Olvidos del Paraíso" description="Esta página fue olvidada del paraíso.">
  <main class="min-h-screen flex items-center justify-center relative overflow-hidden film-grain">
    <!-- Floating blurs for cinematic feel -->
    <div class="absolute top-1/4 left-1/4 w-64 h-64 rounded-full bg-primary/10 blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/3 right-1/4 w-80 h-80 rounded-full bg-accent/10 blur-3xl animate-pulse" style="animation-delay: 2s;"></div>

    <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
      <!-- 404 number -->
      <h1 class="font-heading font-black text-[10rem] md:text-[14rem] leading-none tracking-tight bg-gradient-to-r from-[#D4943E] via-[#C13A3A] to-[#4A6FAD] bg-clip-text text-transparent drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)] select-none">
        404
      </h1>

      <!-- Main message -->
      <p class="text-2xl md:text-3xl font-light text-text mb-4 -mt-4">
        Esta página también fue <span class="italic text-highlight">olvidada</span> del paraíso
      </p>

      <!-- Subtext -->
      <p class="text-text-muted text-lg md:text-xl mb-10 max-w-md mx-auto leading-relaxed">
        Parece que se perdió entre las zonas invisibilizadas de Cancún. Ni los turistas la encuentran.
      </p>

      <!-- Back button -->
      <a
        href="/"
        class="inline-flex items-center gap-2 px-8 py-3 bg-surface-elevated hover:bg-highlight/20 border border-glass-border hover:border-highlight/40 rounded-full text-text transition-all duration-300 group"
      >
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver al paraíso
      </a>

      <!-- Fun small print -->
      <p class="mt-16 text-text-muted/50 text-sm italic">
        "No todos los links habitan en el paraíso que ayudaron a construir"
      </p>
    </div>
  </main>
</Layout>
